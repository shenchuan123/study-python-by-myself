  */
 const SCROLLBAR_LINGER_MS = 2000
 
+/* Conversation body-text size (left sidebar foot). The assistant and user
+   message CSS in ui-conversation read --ds-conv-font-size with a 16px
+   fallback; this slider publishes it on the document root and persists per
+   browser, so the control can live anywhere and still resize the transcript. */
+const CONV_FONT_MIN = 12
+const CONV_FONT_MAX = 28
+const CONV_FONT_STEP = 1
+const CONV_FONT_DEFAULT = 16
+const CONV_FONT_STORAGE_KEY = 'ds.convFontSize'
+
+function readConvFontSize(): number {
+  if (typeof localStorage === 'undefined') return CONV_FONT_DEFAULT
+  try {
+    const value = Number(localStorage.getItem(CONV_FONT_STORAGE_KEY))
+    if (Number.isFinite(value) && value >= CONV_FONT_MIN && value <= CONV_FONT_MAX) return value
+    return CONV_FONT_DEFAULT
+  } catch {
+    /* v8 ignore next -- storage unavailable is non-fatal; fall back to default. */
+    return CONV_FONT_DEFAULT
+  }
+}
+
+function writeConvFontSize(size: number): void {
+  try {
+    localStorage.setItem(CONV_FONT_STORAGE_KEY, String(size))
+  } catch {
+    /* v8 ignore next -- storage unavailable is non-fatal; nothing to persist. */
+  }
+}
+
+function publishConvFontSize(size: number): void {
+  if (typeof document === 'undefined') return
+  document.documentElement.style.setProperty('--ds-conv-font-size', `${size}px`)
+}
+
